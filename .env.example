# Address of your Plex Media Server, as seen from where Swiplex runs.
PLEX_URL=http://localhost:32400

# Public address people use to open Swiplex (recommended behind a reverse proxy).
# Used as the return URL after "Sign in with Plex".
# PUBLIC_URL=https://swiplex.example.com

# Port to listen on (default 8787).
# PORT=8787

# Where the show selection and login sessions are stored (default ./data).
# DATA_DIR=./data

# How long a sign-in lasts, in days (default 90).
# SESSION_DAYS=90
